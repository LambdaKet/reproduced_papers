{
  "description": "Paper's reference for multi-tenant-gain: the same four concurrent clients and workers as multi_tenant_original, but each worker runs one circuit at a time (our reading of single-tenant, Sec. IV-C2).",
  "experiment": {"kind": "multi_tenant"},
  "data": {"pair": [3, 6], "subsample": {"mode": "first", "size": 3000}, "validation_fraction": 0.0},
